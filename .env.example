# Copy these values from Firebase Console > Project settings > Your apps.
# Copy this file to .env.local and replace the placeholders.
# VITE_ values are included in the browser build. Use only Firebase web config,
# never service-account private keys or server credentials.
# Enable Email/Password in Firebase Authentication and publish firestore.rules.
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-web-app-id
# Optional local testing only. The cloud tests set this automatically.
VITE_FIREBASE_USE_EMULATORS=false
