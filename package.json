{
  "name": "form-workout-planner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A mobile-first weekly gym planner with local workout tracking.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node server.mjs --dev",
    "build": "vite build",
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write src shared tests server.mjs playwright.config.js package.json README.md"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "prettier": "^3.9.9",
    "vite": "^6.3.0"
  }
}
